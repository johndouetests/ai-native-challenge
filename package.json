{
  "name": "pointshub",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "PointsHub loyalty points service",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-fastify": "^11.2.8",
    "@nestjs/typeorm": "^11.0.3",
    "better-sqlite3": "^12.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "test": "jest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:reset": "node -e \"require('fs').rmSync('data',{recursive:true,force:true})\"",
    "submit:pack": "node scripts/pack.mjs"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "tests/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "testEnvironment": "node",
    "testTimeout": 20000
  }
}

{
  "name": "deskline-inbox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n sim,web -c magenta,cyan \"npm:sim\" \"npm:dev:web\"",
    "dev:web": "vite",
    "sim": "tsx server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:sim": "vitest run --project sim",
    "shots": "tsx scripts/shots.ts",
    "submit:pack": "node scripts/pack.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "fastify": "^5.12.7",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "playwright": "1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  }
}
